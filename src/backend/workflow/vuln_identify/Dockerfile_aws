# AWS Batch Dockerfile for Vulnerability Code Identification
FROM python:3.13-slim AS build

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

ENV POETRY_HOME="/opt/poetry"
ENV POETRY_VERSION="2.0.1"
RUN curl -sSL https://install.python-poetry.org | python3 -

ENV PATH=$POETRY_HOME/bin:$PATH

WORKDIR /app
ENV POETRY_VIRTUALENVS_IN_PROJECT=1

COPY poetry.lock pyproject.toml ./
RUN poetry install --only main --no-root

RUN .venv/bin/pip install semgrep==1.99.0

COPY src/backend/workflow/vuln_identify/ ./src/backend/workflow/vuln_identify/
COPY src/backend/utils/ ./src/backend/utils/
COPY src/backend/schemas/ ./src/backend/schemas/

RUN touch src/__init__.py \
    && touch src/backend/__init__.py \
    && touch src/backend/workflow/__init__.py \
    && touch src/backend/workflow/vuln_identify/__init__.py \
    && touch src/backend/utils/__init__.py \
    && touch src/backend/schemas/__init__.py

FROM python:3.13-slim

RUN apt-get update && apt-get install -y \
    git \
    curl \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSfL https://github.com/cli/cli/releases/download/v2.62.0/gh_2.62.0_linux_amd64.tar.gz -o /tmp/gh.tar.gz && \
    tar -xzf /tmp/gh.tar.gz -C /tmp && \
    mv /tmp/gh_2.62.0_linux_amd64/bin/gh /usr/local/bin/gh && \
    chmod +x /usr/local/bin/gh && \
    rm -rf /tmp/gh.tar.gz /tmp/gh_2.62.0_linux_amd64


RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /app

COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/src /app/src

RUN SEMGREP_BIN=$(/app/.venv/bin/python -c "import semgrep, os; print(os.path.join(os.path.dirname(semgrep.__file__), 'bin', 'semgrep-core'))") && \
    if [ -f "$SEMGREP_BIN" ]; then \
        cp "$SEMGREP_BIN" /usr/local/bin/pysemgrep && \
        chmod +x /usr/local/bin/pysemgrep && \
        echo "Copied semgrep binary: $(ls -lh /usr/local/bin/pysemgrep)"; \
    else \
        echo "WARNING: semgrep-core binary not found at $SEMGREP_BIN"; \
    fi

RUN echo '#!/app/.venv/bin/python' > /usr/local/bin/semgrep && \
    tail -n +2 /app/.venv/bin/semgrep >> /usr/local/bin/semgrep && \
    chmod +x /usr/local/bin/semgrep

ENV PATH=/usr/local/bin:/app/.venv/bin:$PATH
ENV PYTHONPATH=/app
ENV WORKDIR=/app
ENV PYTHONUNBUFFERED=1

COPY src/backend/workflow/vuln_identify/batch_job.py /app/batch_job.py

RUN echo "=== Verifying installation ===" && \
    python --version && \
    echo "Checking semgrep binary..." && \
    ls -lh /usr/local/bin/semgrep && \
    ls -lh /usr/local/bin/pysemgrep && \
    echo "Checking gh CLI..." && \
    gh --version && \
    echo "Checking git..." && \
    git --version && \
    echo "Testing Python imports..." && \
    /app/.venv/bin/python -c "from src.backend.workflow.vuln_identify.vuln_code_identify import vuln_code_identify; print('✓ vuln_code_identify import successful')" && \
    /app/.venv/bin/python -c "import semgrep; print('✓ semgrep module import successful')" && \
    echo "=== All verifications passed ==="

ENTRYPOINT ["/app/.venv/bin/python", "-u", "/app/batch_job.py"]