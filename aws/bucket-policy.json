{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOrgList",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::vg-vuln-scan-artifacts-20251016215106",
      "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-rlthxqtxif" } }
    },
    {
      "Sid": "AllowOrgObjectsReadWrite",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject","s3:PutObject"],
      "Resource": "arn:aws:s3:::vg-vuln-scan-artifacts-20251016215106/*",
      "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-rlthxqtxif" } }
    },
    {
      "Sid": "DenyNonTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::vg-vuln-scan-artifacts-20251016215106",
        "arn:aws:s3:::vg-vuln-scan-artifacts-20251016215106/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
